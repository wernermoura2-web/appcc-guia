{
  "id": "/appcc-guia/",
  "name": "Guia APPCC — Envasadoras RJ",
  "short_name": "Guia APPCC",
  "description": "Revisão do guia estadual de avaliação do risco de envasadoras. Preenchimento local e acesso offline.",
  "lang": "pt-BR",
  "start_url": "/appcc-guia/index.html",
  "scope": "/appcc-guia/",
  "display": "standalone",
  "background_color": "#edf3f7",
  "theme_color": "#075a9c",
  "icons": [
    {
      "src": "/appcc-guia/icon-appcc-pcc-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/appcc-guia/icon-appcc-pcc-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://wernermoura2-web.github.io/appcc-guia/manifest.webmanifest",
      "id": "https://wernermoura2-web.github.io/appcc-guia/"
    }
  ]
