3.70078740157489,128.9763779527559,64.94583989501312]},{"name":"foto_46_imagem","kind":"foto","index":46,"page":17,"rect":[162.99212598425197,73.70078740157489,128.9763779527559,64.94583989501312]},{"name":"foto_47_imagem","kind":"foto","index":47,"page":17,"rect":[303.30708661417316,73.70078740157489,128.9763779527559,64.94583989501312]},{"name":"foto_48_imagem","kind":"foto","index":48,"page":17,"rect":[443.6220472440944,73.70078740157489,128.9763779527559,64.94583989501312]},{"name":"rotulo_1_imagem","kind":"rotulo","index":1,"page":20,"rect":[22.67716535433071,515.8463517060369,549.9212598425197,194.14364829396328]},{"name":"rotulo_2_imagem","kind":"rotulo","index":2,"page":20,"rect":[22.67716535433071,282.0176640419948,549.9212598425197,194.14364829396328]},{"name":"rotulo_3_imagem","kind":"rotulo","index":3,"page":20,"rect":[22.67716535433071,48.18897637795276,549.9212598425197,194.14364829396328]},{"name":"rotulo_4_imagem","kind":"rotulo","index":4,"page":21,"rect":[22.67716535433071,515.8463517060369,549.9212598425197,194.14364829396328]},{"name":"rotulo_5_imagem","kind":"rotulo","index":5,"page":21,"rect":[22.67716535433071,282.0176640419948,549.9212598425197,194.14364829396328]},{"name":"rotulo_6_imagem","kind":"rotulo","index":6,"page":21,"rect":[22.67716535433071,48.18897637795276,549.9212598425197,194.14364829396328]},{"name":"rotulo_7_imagem","kind":"rotulo","index":7,"page":22,"rect":[22.67716535433071,515.8463517060369,549.9212598425197,194.14364829396328]},{"name":"rotulo_8_imagem","kind":"rotulo","index":8,"page":22,"rect":[22.67716535433071,282.0176640419948,549.9212598425197,194.14364829396328]},{"name":"rotulo_9_imagem","kind":"rotulo","index":9,"page":22,"rect":[22.67716535433071,48.18897637795276,549.9212598425197,194.14364829396328]}],"ncLevels":{"PC":1,"PPR":2,"PPHO":3,"PPRO":4,"PCC":5}};\n/* Motor compartilhado pelo PDF e pelo preenchimento do PDF no navegador. */\nfunction AppccCalculate\(config, values\) {\n var output={}, disabled={}, results=[], activeSources={},mirrored={},weights={PCC:40,PC:25,PPR:15,PPRO:12,PPHO:8};\n function raw\(n\){return values[n]==null?'':String\(values[n]\);}\n function answer\(n\){var v=raw\(n\).replace\(/^\\//,''\).toUpperCase\(\);return v==='SIM'||v==='S'?'SIM':v==='N\303O'||v==='NAO'||v==='N'?'N\303O':v==='NA'||v==='N\303O APLIC\301VEL'?'NA':'';}\n function number\(v\){var s=String\(v\).trim\(\).replace\(/\\s/g,''\).replace\('%',''\);if\(s.indexOf\(','\)>=0\)s=s.replace\(/\\./g,''\).replace\(',','.'\);var n=Number\(s\);return s!==''&&isFinite\(n\)?n:null;}\n function risk\(code,pc\){return pc===null?'Pendente':config.strict.indexOf\(code\)>=0?\(pc===100?'Baixo':pc>=76?'M\351dio':'Alto'\):\(pc>=76?'Baixo':pc>50?'M\351dio':'Alto'\);}\n function maxRisk\(rs\){if\(rs.indexOf\('Alto'\)>=0\)return 'Alto';if\(rs.indexOf\('Pendente'\)>=0||rs.indexOf\('N\343o avaliado'\)>=0\)return 'Pendente';if\(rs.indexOf\('M\351dio'\)>=0\)return 'M\351dio';if\(rs.indexOf\('Baixo'\)>=0\)return 'Baixo';return 'N\343o aplic\341vel';}\n for\(var mi=0;mi<config.mirrors.length;mi++\){values[config.mirrors[mi].target]=raw\(config.mirrors[mi].source\);mirrored[config.mirrors[mi].target]=true;}\n for\(var gi=0;gi<config.groups.length;gi++\){\n  var g=config.groups[gi],used=false,pending=false,items=[];\n  for\(var mi=0;mi<g.metadata.length;mi++\)if\(!mirrored[g.metadata[mi]]&&raw\(g.metadata[mi]\)&&raw\(g.metadata[mi]\)!=='Off'&&raw\(g.metadata[mi]\)!=='/Off'\)used=true;\n  for\(var ii=0;ii<g.items.length;ii++\){\n   var item=g.items[ii],v=answer\(item.answer\),cl=raw\(item.classField\),classes=cl&&cl!=='Por frase'&&cl.indexOf\('Original:'\)!==0?[cl]:item.classes;\n   var nc=0;for\(var ci=0;ci<classes.length;ci++\)nc=Math.max\(nc,\(config.ncLevels||{PC:1,PPR:2,PPHO:3,PPRO:4,PCC:5}\)[classes[ci]]||0\);\n   var prob=number\(raw\(item.probabilityField\)\),valid=prob!==null&&prob>=1&&prob<=5&&Math.floor\(prob\)===prob;\n   var phraseRows=[];try{phraseRows=JSON.parse\(raw\(item.phraseField\)||'[]'\);}catch\(e\){}\n   var phraseScore=null,hasPhrase=false,phrasePending=false,anyNo=false,allNA=true;\n   for\(var fj=0;fj<\(item.phrases||[]\).length;fj++\)if\(phraseRows[fj]&&phraseRows[fj].v\)hasPhrase=true;\n   if\(hasPhrase\){\n    var scored=[];\n    for\(var fj=0;fj<item.phrases.length;fj++\){\n     var def=item.phrases[fj],fr=phraseRows[fj]||{},fv=fr.v||'';\n     if\(fv==='NA'&&def.na\)continue;allNA=false;if\(fv==='N\303O'\)anyNo=true;\n     var fp=fr.p===undefined||fr.p===''?prob:number\(fr.p\),fnc=\(config.ncLevels||{}\)[def.cls]||0;\n     if\(!fv||fp===null||fp<1||fp>5||Math.floor\(fp\)!==fp\)phrasePending=true;\n     scored.push\({v:fv,w:fnc*\(fp||0\),nc:fnc}\);\n    }\n    v=allNA?'NA':anyNo?'N\303O':phrasePending?'':'SIM';\n    phraseScore=0;var phraseNC=nc;for\(var fj=0;fj<scored.length;fj++\)if\(scored[fj].v===\(v==='N\303O'?'N\303O':'SIM'\)&&scored[fj].w>=phraseScore\){phraseScore=scored[fj].w;phraseNC=scored[fj].nc;}\n    values[item.answer]=v;output[item.answer]=v;\n   }\n\n   output[item.ncField]=String\(nc\);if\(item.unitNcField\)output[item.unitNcField]=hasPhrase?String\(phraseNC\):String\(nc\);output[item.weightField]=valid?String\(nc*prob\):'';\n   if\(v\)used=true;if\(v==='NA'\)continue;\n   if\(!v||\(hasPhrase?phrasePending:!valid\)\)pending=true;items.push\({v:v,w:hasPhrase?phraseScore:valid?nc*prob:0}\);\n  }\n  var pc=null,r='N\343o avaliado';\n  if\(used\)for\(var ai=0;ai<g.items.length;ai++\)activeSources[g.items[ai].answer]=true;\n  if\(used\){if\(!items.length\)r='N\343o aplic\341vel';else if\(pending\)r='Pendente';else{var earned=0,total=0;for\(var j=0;j<items.length;j++\){total+=items[j].w;if\(items[j].v==='SIM'\)earned+=items[j].w;}pc=total?Math.round\(1000*earned/total\)/10:null;r=risk\(g.proc,pc\);}}\n  output[g.percent]=pc===null?'':String\(pc\).replace\('.',','\)+'%';output[g.risk]=used?r:'';results.push\({group:g,pc:pc,risk:r,used:used}\);\n }\n\n for\(var i=0;i<config.rows.length;i++\){\n  var row=config.rows[i],v='',has=false,missing=false,active=false;\n  for\(var j=0;j<row.sources.length;j++\){if\(!activeSources[row.sources[j]]\)continue;active=true;var a=answer\(row.sources[j]\);if\(a==='N\303O'\){v='N\303O';break;}if\(!a\)missing=true;else if\(a==='SIM'\)has=true;}\n  if\(!v\)v=!active?'':missing?'Pendente':has?'SIM':'NA';output[row.result]=v;\n }\n for\(var page in config.pages\){\n  var indexes=config.pages[page],rs=[],pcs=[];\n  for\(var j=0;j<indexes.length;j++\){var r=results[indexes[j]];if\(r.used\){rs.push\(r.risk\);if\(r.pc!==null\)pcs.push\(r.pc\);}}\n  output['p'+page+'_risk_result']=rs.length?maxRisk\(rs\):'N\343o avaliado';output['p'+page+'_percent_result']=pcs.length&&rs.indexOf\('Pendente'\)<0?String\(Math.min.apply\(Math,pcs\)\).replace\('.',','\)+'%':'';\n }\n var plantRisks=[];\n for\(var pi=0;pi<config.processes.length;pi++\){\n  var code=config.processes[pi],rs=[],list=[];\n  for\(var j=0;j<results.length;j++\){var result=results[j];if\(result.group.proc===code&&result.used\){rs.push\(result.risk\);list.push\(result\);}}\n  var procRisk=rs.length?maxRisk\(rs\):'N\343o avaliado';plantRisks.push\(procRisk\);output['p18_risco_'+\(pi+1\)]=procRisk;\n  for\(var j=0;j<16;j++\)output['p18_linha_'+\(pi+1\)+'_'+\(j+1\)]=list[j]?\(list[j].group.label+': '+\(list[j].risk==='N\343o aplic\341vel'?'NA':list[j].risk\)\):'';\n }\n var plant=maxRisk\(plantRisks\),n=plant==='Baixo'?1:plant==='M\351dio'?2:plant==='Alto'?3:0;\n output.p18_risco_estabelecimento=plant;output.p19_classificacao=n?'Grupo'+n:'Off';output.p19_classificacao_automatica=n?'Grupo '+n+' - Estabelecimento de '+plant+' Risco':'Classifica\347\343o: '+plant;\n var sum=0,count=0;\n for\(var j=0;j<config.flows.length;j++\){var value=number\(raw\(config.flows[j]\)\);if\(value!==null&&value>=0\){sum+=value;count++;}}\n output.p1_vazao_total=count?String\(Math.round\(sum*1000\)/1000\).replace\('.',','\):'';\n for\(var j=0;j<8;j++\){var field='legal_'+j+'_atende';disabled[field]=raw\('legal_'+j+'_situacao'\)!=='Entregue';if\(disabled[field]\)output[field]='Off';}\n for\(var j=0;j<config.mirrors.length;j++\){var mirror=config.mirrors[j];output[mirror.target]=raw\(mirror.source\);}\n return {values:output,disabled:disabled,groups:results,risk:plant};\n}\nif\(typeof module!=='undefined'&&module.exports\)module.exports=AppccCalculate;\n\nvar APPCC_UPDATING=false;\nfunction appccPDFUpdate\(name,value\){\n if\(APPCC_UPDATING\)return;APPCC_UPDATING=true;\n try{\n  var values={},fields=this.numFields;\n  for\(var i=0;i<fields;i++\){var n=this.getNthFieldName\(i\),f=this.getField\(n\);values[n]=f?String\(f.valueAsString||f.value||''\):'';}\n  if\(name&&value!==undefined\)values[name]=String\(value\);\n  for\(var serial in APPCC_CONFIG.classes\){var links=APPCC_CONFIG.classes[serial];for\(var i=0;i<links.length;i++\)for\(var k=0;k<2;k++\)if\(links[i][k]===name\){for\(var j=0;j<links.length;j++\){values[links[j][k]]=String\(value\);var f=this.getField\(links[j][k]\);if\(f&&links[j][k]!==name\)f.value=value;}}}\n  var result=AppccCalculate\(APPCC_CONFIG,values\);\n  for\(var n in result.values\){var f=this.getField\(n\);if\(f\){f.value=result.values[n];if\(f.type==='text'\)f.textSize=0;}}\n  for\(var n in result.disabled\){var f=this.getField\(n\);if\(f\){f.readonly=result.disabled[n];f.fillColor=result.disabled[n]?['G',.92]:['G',1];}}\n }finally{APPCC_UPDATING=false;}\n}\nappccPDFUpdate.call\(this\);\n\n\nfunction appccPDFPhrases\(answerName\){\n var item=null;for\(var gi=0;gi<APPCC_CONFIG.groups.length;gi++\)for\(var ii=0;ii<APPCC_CONFIG.groups[gi].items.length;ii++\)if\(APPCC_CONFIG.groups[gi].items[ii].answer===answerName\)item=APPCC_CONFIG.groups[gi].items[ii];\n if\(!item\)return;var field=this.getField\(item.phraseField\),rows=[];try{rows=JSON.parse\(field.valueAsString||'[]'\);}catch\(e\){}\n for\(var j=0;j<item.phrases.length;j++\){\n  var f=item.phrases[j],row=rows[j]||{},reply=app.response\({cQuestion:'Frase '+\(j+1\)+': '+f.text+'\\nAPPCC '+f.cls+' | NC '+APPCC_CONFIG.ncLevels[f.cls]+'\\nResponda S \(Sim\), N \(N\343o\)'+\(f.na?', NA \(N\343o aplic\341vel\)':''\)+' ou deixe vazio \(pendente\).',cTitle:'Indicador '+item.serial,cDefault:row.v==='SIM'?'S':row.v==='N\303O'?'N':row.v||''}\);\n  if\(reply===null\)return;reply=String\(reply\).toUpperCase\(\).replace\(/^\\s+|\\s+$/g,''\);if\(['','S','N','NA'].indexOf\(reply\)<0||reply==='NA'&&!f.na\){app.alert\('Resposta inv\341lida.'\);return;}\n  var pv=app.response\({cQuestion:'Probabilidade da frase '+\(j+1\)+' \(1 a 5\). Vazio utiliza a probabilidade do item.',cTitle:'Probabilidade',cDefault:row.p===undefined?'':String\(row.p\)}\);\n  if\(pv===null\)return;if\(pv!==''&&\(!isFinite\(Number\(pv\)\)||Number\(pv\)<1||Number\(pv\)>5||Math.floor\(Number\(pv\)\)!==Number\(pv\)\)\){app.alert\('Use um n\372mero inteiro de 1 a 5.'\);return;}\n  rows[j]={v:reply==='S'?'SIM':reply==='N'?'N\303O':reply,p:pv};\n }\n field.value=JSON.stringify\(rows\);appccPDFUpdate.call\(this\);\n}\n)>>
