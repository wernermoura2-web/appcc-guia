\\u00e1vel para coleta de amostras instalada no reservat\\u00f3rio ou no in\\u00edcio da tubula\\u00e7\\u00e3o da \\u00e1gua \\u00e0s instala\\u00e7\\u00f5es de envasamento; e VII - dispositivo seguro para acesso e inspe\\u00e7\\u00f5es \\u00e0 parte superior.","cls":"PC","na":false},{"text":"Os elementos filtrantes devem ser verificados e trocados na frequ\\u00eancia definida pelo estabelecimento industrial, a partir da an\\u00e1lise de par\\u00e2metros f\\u00edsico-qu\\u00edmicos da \\u00e1gua para consumo humano, sendo mantidos os registros.","cls":"PPRO","na":false},{"text":"Os filtros de ar microbiol\\u00f3gicos devem ser verificados e trocados na frequ\\u00eancia definida pelo estabelecimento industrial, sendo mantidos os registros.","cls":"PPRO","na":false}],"phraseField":"p6_res_i14_u2_frases","unitNcField":"p6_res_i14_u2_nc","editorTemplates":["APPCC_Frases_i14_1"]},{"answer":"p6_res_i15_u2","serial":15,"classes":["PPHO"],"classField":"p6_appcc_i15_classe","weightField":"p6_appcc_i15_peso","probability":4,"probabilityField":"p6_appcc_i15_probabilidade","ncField":"p6_appcc_i15_criticidade","phrases":[{"text":"A inspe\\u00e7\\u00e3o visual do reservat\\u00f3rio deve ser efetuada na frequ\\u00eancia definida pelo estabelecimento industrial.","cls":"PPHO","na":false},{"text":"Caso seja constatada a presen\\u00e7a de incrusta\\u00e7\\u00f5es e de outras altera\\u00e7\\u00f5es que possam comprometer a qualidade higi\\u00eanico-sanit\\u00e1ria das \\u00e1guas, devem ser revistas as opera\\u00e7\\u00f5es de higieniza\\u00e7\\u00e3o e adotadas as medidas corretivas necess\\u00e1rias.","cls":"PPHO","na":false}],"phraseField":"p6_res_i15_u2_frases","unitNcField":"p6_res_i15_u2_nc","editorTemplates":["APPCC_Frases_i15_1"]},{"answer":"p6_res_i16_u2","serial":16,"classes":["PPHO","PPR"],"classField":"p6_appcc_i16_classe","weightField":"p6_appcc_i16_peso","probability":3,"probabilityField":"p6_appcc_i16_probabilidade","ncField":"p6_appcc_i16_criticidade","phrases":[{"text