 que se fizerem necess\\u00e1rias.","cls":"PPHO","na":false}],"phraseField":"p7_rec_desc_i24_u2_frases","unitNcField":"p7_rec_desc_i24_u2_nc"}],"metadata":[],"percent":"p7_percent_u2","risk":"p7_risk_u2"},{"proc":"4.5","page":7,"column":2,"label":"3","items":[{"answer":"p7_rec_rot_i25_u3","serial":22,"classes":["PC"],"classField":"p7_appcc_i22_classe","weightField":"p7_appcc_i22_peso","probability":5,"probabilityField":"p7_appcc_i22_probabilidade","ncField":"p7_appcc_i22_criticidade","phrases":[{"text":"Os insumos devem ser submetidos \\u00e0 inspe\\u00e7\\u00e3o no ato da recep\\u00e7\\u00e3o.","cls":"PC","na":false},{"text":"Quando as especifica\\u00e7\\u00f5es previamente determinadas n\\u00e3o forem atendidas, os insumos devem ser reprovados.","cls":"PC","na":false}],"phraseField":"p7_rec_rot_i25_u3_frases","unitNcField":"p7_rec_rot_i25_u3_nc"},{"answer":"p7_rec_rot_i26_u3","serial":20,"classes":["PC"],"classField":"p7_appcc_i20_classe","weightField":"p7_appcc_i20_peso","probability":4,"probabilityField":"p7_appcc_i20_probabilidade","ncField":"p7_appcc_i20_criticidade","phrases":[{"text":"Os insumos reprovados na recep\\u00e7\\u00e3o devem ser imediatamente devolvidos ao fornecedor ou distribuidor e, quando n\\u00e3o for poss\\u00edvel, devem ser devidamente identificados e armazenados separadamente at\\u00e9 o seu destino final, sendo esse destino registrado em documento datado e assinado pelo funcion\\u00e1rio respons\\u00e1vel.","cls":"PC","na":true}],"phraseField":"p7_rec_rot_i26_u3_frases","unitNcField":"p7_rec_rot_i26_u3_nc"},{"answer":"p7_rec_rot_i27_u3","serial":21,"classes":["PPHO"],"classField":"p7_appcc_i21_classe","weightField":"p7_appcc_i21_peso","probability":3,"probabilityField":"p7_appcc_i21_probabilidade","ncField":"p7_appcc_i21_criticidade","phrases":[{"text":"Devem ser implementados Procedimentos Operacionais Padronizados-POP referentes \\u00e0 opera\\u00e7\\u00e3o de recep\\u00e7\\u00e3o das embalagens.","cls":"PPHO","na":false},{"text":"Os POP devem conter informa\\u00e7\\u00f5es sobre: inspe\\u00e7\\u00e3o individual, aceita\\u00e7\\u00e3o e reprova\\u00e7\\u00e3o de embalagens, destino final das embalagens reprovadas e outras informa\\u00e7\\u00f5es que se fizerem necess\\u00e1rias.","cls":"PPHO","na":false}],"phraseField":"p7_rec_rot_i27_u3_frases","unitNcField":"p7_rec_rot_i27_u3_nc"}],"metadata":[],"percent":"p7_percent_u3","risk":"p7_risk_u3"},{"proc":"4.5","page":7,"column":3,"label":"4","items":[{"answer":"p7_rec_san_i28_u4","serial":22,"classes":["PC"],"classField":"p7_appcc_i22_classe","weightField":"p7_appcc_i22_peso","probability":5,"probabilityField":"p7_appcc_i22_probabilidade","ncField":"p7_appcc_i22_criticidade","phrases":[{"text":"Os insumos devem ser submetidos \\u00e0 inspe\\u00e7\\u00e3o no ato da recep\\u00e7\\u00e3o.","cls":"PC","na":false},{"text":"Quando as especifica\\u00e7\\u00f5es previamente determinadas n\\u00e3o forem atendidas, os insumos devem ser reprovados.","cls":"PC","na":false}],"phraseField":"p7_rec_san_i28_u4_frases","unitNcField":"p7_rec_san_i28_u4_nc"},{"answer":"p7_rec_san_i29_u4","serial":20,"classes":["PC"],"classField":"p7_appcc_i20_classe","weightField":"p7_appcc_i20_peso","probability":4,"probabilityField":"p7_appcc_i20_probabilidade","ncField":"p7_appcc_i20_criticidade","phrases":[{"text":"Os insumos reprovados na recep\\u00e7\\u00e3o devem ser imediatamente devolvidos ao fornecedor ou distribuidor e, quando n\\u00e3o for poss\\u00edvel, devem ser devidamente identificados e armazenados separadamente at\\u00e9 o seu destino final, sendo esse destino registrado em documento datado e assinado pelo funcion\\u00e1rio respons\\u00e1vel.","cls":"PC","na":true}],"phraseField":"p7_rec_san_i29_u4_frases","unitNcField":"p7_rec_san_i29_u4_nc"}],"metadata":[],"percent":"p7_percent_u4","risk":"p7_risk_u4"},{"proc":"4.6","page":8,"column":0,"label":"1","items":[{"answer":"p8_h_ret_i30_u1","serial":30,"classes":["PPRO"],"classField":"p8_appcc_i30_classe","weightField":"p8_appcc_i30_peso","probability":3,"probabilityField":"p8_appcc_i30_probabilidade","ncField":"p8_appcc_i30_criticidade","phrases":[{"text":"As embalagens de primeiro uso, quando n\\u00e3o fabricadas no pr\\u00f3prio estabelecimento industrial, devem ser submetidas ao enx\\u00e1gue em equipamento autom\\u00e1tico, utilizando- se solu\\u00e7\\u00e3o desinfetante.","cls":"PPRO","na":false}],"phraseField":"p8_h_ret_i30_u1_frases","unitNcField":"p8_h_ret_i30_u1_nc"},{"answer":"p8_h_ret_i31_u1","serial":31,"classes":["PPHO"],"classField":"p8_appcc_i31_classe","weightField":"p8_appcc_i31_peso","probability":2,"probabilityField":"p8_appcc_i31_probabilidade","ncField":"p8_appcc_i31_criticidade","phrases":[{"text":"As embalagens retornadas para um novo ciclo de uso, antes da etapa de higieniza\\u00e7\\u00e3o autom\\u00e1tica, devem ser submetidas \\u00e0 pr\\u00e9-lavagem para a remo\\u00e7\\u00e3o do r\\u00f3tulo, dos res\\u00edduos da subst\\u00e2ncia adesiva e das sujidades das superf\\u00edcies interna e externa.","cls":"PPHO","na":false}],"phraseField":"p8_h_ret_i31_u1_frases","unitNcField":"p8_h_ret_i31_u1_nc"},{"answer":"p8_h_ret_i32_u1","serial":32,"classes":["PCC"],"classField":"p8_appcc_i32_classe","weightField":"p8_appcc_i32_peso","probability":3,"probabilityField":"p8_appcc_i32_probabilidade","ncField":"p8_appcc_i32_criticidade","phrases":[{"text":"Ap\\u00f3s o processo de pr\\u00e9-lavagem de que trata o caput, as embalagens devem ser submetidas \\u00e0 limpeza e desinfec\\u00e7\\u00e3o em equipamento autom\\u00e1tico.","cls":"PCC","na":false}],"phraseField":"p8_h_ret_i32_u1_frases","unitNcField":"p8_h_ret_i32_u1_nc"},{"answer":"p8_h_ret_i33_u1","serial":33,"classes":["PPRO"],"classField":"p8_appcc_i33_classe","weightField":"p8_appcc_i33_peso","probability":4,"probabilityField":"p8_appcc_i33_probabilidade","ncField":"p8_appcc_i33_criticidade","phrases":[{"text":"O enx\\u00e1gue das embalagens deve eliminar os res\\u00edduos dos produtos qu\\u00edmicos utilizados na higieniza\\u00e7\\u00e3o.","cls":"PPRO","na":false},{"text":"A elimina\\u00e7\\u00e3o dos res\\u00edduos deve ser comprovada por testes indicadores, dos quais devem ser mantidos os devidos registros.","cls":"PPRO","na":false}],"phraseField":"p8_h_ret_i33_u1_frases","unitNcField":"p8_h_ret_i33_u1_nc"},{"answer":"p8_h_ret_i34_u1","serial":34,"classes":["PCC"],"classField":"p8_appcc_i34_classe","weightField":"p8_appcc_i34_peso","probability":3,"probabilityField":"p8_appcc_i34_probabilidade","ncField":"p8_appcc_i34_criticidade","phrases":[{"text":"O enx\\u00e1g\\u00fce final das embalagens retornadas para um novo ciclo de uso e daquelas de primeiro uso deve ser feito com a \\u00e1gua mineral natural ou com a \\u00e1gua natural a ser envasada, exceto as embalagens descart\\u00e1veis do tipo copo.","cls":"PCC","na":false}],"phraseField":"p8_h_ret_i34_u1_frases","unitNcField":"p8_h_ret_i34_u1_nc"},{"answer":"p8_h_ret_i35_u1","serial":35,"classes":["PPR"],"classField":"p8_appcc_i35_classe","weightField":"p8_appcc_i35_peso","probability":2,"probabilityField":"p8_appcc_i35_probabilidade","ncField":"p8_appcc_i35_criticidade","phrases":[{"text":"O transporte das embalagens da \\u00e1rea de higieniza\\u00e7\\u00e3o para a sala de envase deve ser realizado imediatamente por meio de esteiras rol\\u00e1veis e autom\\u00e1ticas.","cls":"PPR","na":false},{"text":"A sa\\u00edda do equipamento de higieniza\\u00e7\\u00e3o das embalagens deve estar posicionada pr\\u00f3xima \\u00e0 sala de envase, para evitar que as embalagens circulem em ambiente aberto.","cls":"PPR","na":false},{"text":"Quando isto n\\u00e3o for poss\\u00edvel, as esteiras devem ser protegidas por cobertura.","cls":"PPR","na":false}],"phraseField":"p8_h_ret_i35_u1_frases","unitNcField":"p8_h_ret_i35_u1_nc"},{"answer":"p8_h_ret_i36_u1","serial":36,"classes":["PPR"],"classField":"p8_appcc_i36_classe","weightField":"p8_appcc_i36_peso","probability":3,"probabilityField":"p8_appcc_i36_probabilidade","ncField":"p8_appcc_i36_criticidade","phrases":[{"text":"A passagem das embalagens da \\u00e1rea de higieniza\\u00e7\\u00e3o para a sala de envase deve ser feita por meio de abertura destinada exclusivamente para este fim, n\\u00e3o sendo permitido o transporte manual das embalagens.","cls":"PPR","na":false},{"text":"A abertura a que se refere o caput deve ser dimensionada para permitir somente a passagem das embalagens e permanecer fechada durante a paralisa\\u00e7\\u00e3o do processo de envase","cls":"PPR","na":false}],"phraseField":"p8_h_ret_i36_u1_frases","unitNcField":"p8_h_ret_i36_u1_nc"},{"answer":"p8_h_ret_i37_u1","serial":37,"classes":["PPHO"],"classField":"p8_appcc_i37_classe","weightField":"p8_appcc_i37_peso","probability":4,"probabilityField":"p8_appcc_i37_probabilidade","ncField":"p8_appcc_i37_criticidade","phrases":[{"text":"As opera\\u00e7\\u00f5es de limpeza e desinfec\\u00e7\\u00e3o das embalagens devem ser realizadas por funcion\\u00e1rios comprovadamente capacitados, seguindo procedimentos que assegurem condi\\u00e7\\u00f5es higi\\u00eanico- sanit\\u00e1rias satisfat\\u00f3rias.","cls":"PPHO","na":false}],"phraseField":"p8_h_ret_i37_u1_frases","unitNcField":"p8_h_ret_i37_u1_nc"},{"answer":"p8_h_ret_i38_u1","serial":38,"classes":["PPHO"],"classField":"p8_appcc_i38_classe","weightField":"p8_appcc_i38_peso","probability":4,"probabilityField":"p8_appcc_i38_probabilidade","ncField":"p8_appcc_i38_criticidade","phrases":[{"text":"Devem ser implementados Procedimentos Operacionais Padronizados-POP referentes \\u00e0s opera\\u00e7\\u00f5es de higieniza\\u00e7\\u00e3o das embalagens.","cls":"PPHO","na":false},{"text":"Os POP devem conter informa\\u00e7\\u00f5es sobre: natureza da superf\\u00edcie a ser higienizada, m\\u00e9todos de higieniza\\u00e7\\u00e3o, princ\\u00edpios ativos utilizados e sua concentra\\u00e7\\u00e3o, tempo de contato dos agentes qu\\u00edmicos e ou f\\u00edsicos utilizados na opera\\u00e7\\u00e3o de higieniza\\u00e7\\u00e3o, temperatura e outras informa\\u00e7\\u00f5es que se fizerem necess\\u00e1rias.","cls":"PPHO","na":false}],"phraseField":"p8_h_ret_i38_u1_frases","unitNcField":"p8_h_ret_i38_u1_nc"},{"answer":"p8_h_ret_i39_u1","serial":39,"classes":["PC"],"classField":"p8_appcc_i39_classe","weightField":"p8_appcc_i39_peso","probability":4,"probabilityField":"p8_appcc_i39_probabilidade","ncField":"p8_appcc_i39_criticidade","phrases":[{"text":"As condi\\u00e7\\u00f5es de opera\\u00e7\\u00e3o da m\\u00e1quina higienizadora das embalagens retorn\\u00e1veis devem ser aquelas estabelecidas no teste de efici\\u00eancia do processo de higieniza\\u00e7\\u00e3o descrito na norma ABNT 14637 \(Embalagem pl\\u00e1stica para \\u00e1gua mineral e pot\\u00e1vel de mesa - Garraf\\u00e3o retorn\\u00e1vel - requisitos para lavagem, enchimento e fechamento\) ou outra que venha a substitui-la.","cls":"PC","na":false},{"text":"O relat\\u00f3rio da avalia\\u00e7\\u00e3o das condi\\u00e7\\u00f5es de opera\\u00e7\\u00e3o deve ser mantido no empreendimento \\u00e0 disposi\\u00e7\\u00e3o da fiscaliza\\u00e7\\u00e3o.","cls":"PC","na":false}],"phraseField":"p8_h_ret_i39_u1_frases","unitNcField":"p8_h_ret_i39_u1_nc"}],"metadata":["p8_identificacao_0_0"],"percent":"p8_percent_u1","risk":"p8_risk_u1"},{"proc":"4.6","page":8,"column":1,"label":"2","items":[{"answer":"p8_h_ret_i30_u2","serial":30,"classes":["PPRO"],"classField":"p8_appcc_i30_classe","weightField":"p8_appcc_i30_peso","probability":3,"probabilityField":"p8_appcc_i30_probabilidade","ncField":"p8_appcc_i30_criticidade","phrases":[{"text":"As embalagens de primeiro uso, quando n\\u00e3o fabricadas no pr\\u00f3prio estabelecimento industrial, devem ser submetidas ao enx\\u00e1gue em equipamento autom\\u00e1tico, utilizando- se solu\\u00e7\\u00e3o desinfetante.","cls":"PPRO","na":false}],"phraseField":"p8_h_ret_i30_u2_frases","unitNcField":"p8_h_ret_i30_u2_nc"},{"answer":"p8_h_ret_i31_u2","serial":31,"classes":["PPHO"],"classField":"p8_appcc_i31_classe","weightField":"p8_appcc_i31_peso"