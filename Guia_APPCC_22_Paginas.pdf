"],"percent":"p9_percent_u2","risk":"p9_risk_u2"},{"proc":"4.6","page":9,"column":2,"label":"3","items":[{"answer":"p9_h_desc_i43_u3","serial":43,"classes":["PCC"],"classField":"p9_appcc_i43_classe","weightField":"p9_appcc_i43_peso","probability":3,"probabilityField":"p9_appcc_i43_probabilidade","ncField":"p9_appcc_i43_criticidade","phrases":[{"text":"As embalagens de primeiro uso, quando n\\u00e3o fabricadas no pr\\u00f3prio estabelecimento industrial, devem ser submetidas ao enx\\u00e1gue em equipamento autom\\u00e1tico, utilizando- se solu\\u00e7\\u00e3o desinfetante.","cls":"PCC","na":true}],"phraseField":"p9_h_desc_i43_u3_frases","unitNcField":"p9_h_desc_i43_u3_nc"},{"answer":"p9_h_desc_i44_u3","serial":44,"classes":["PC"],"classField":"p9_appcc_i44_classe","weightField":"p9_appcc_i44_peso","probability":4,"probabilityField":"p9_appcc_i44_probabilidade","ncField":"p9_appcc_i44_criticidade","phrases":[{"text":"As embalagens retornadas para um novo ciclo de uso, antes da etapa de higieniza\\u00e7\\u00e3o autom\\u00e1tica, devem ser submetidas \\u00e0 pr\\u00e9-lavagem para a remo\\u00e7\\u00e3o do r\\u00f3tulo, dos res\\u00edduos da subst\\u00e2ncia adesiva e das sujidades das superf\\u00edcies interna e externa.","cls":"PC","na":false}],"phraseField":"p9_h_desc_i44_u3_frases","unitNcField":"p9_h_desc_i44_u3_nc"},{"answer":"p9_h_desc_i45_u3","serial":45,"classes":["PCC"],"classField":"p9_appcc_i45_classe","weightField":"p9_appcc_i45_peso","probability":3,"probabilityField":"p9_appcc_i45_probabilidade","ncField":"p9_appcc_i45_criticidade","phrases":[{"text":"O enx\\u00e1g\\u00fce final das embalagens retornadas para um novo ciclo de uso e daquelas de primeiro uso deve ser feito com a \\u00e1gua mineral natural ou com a \\u00e1gua natural a ser envasada, exceto as embalagens descart\\u00e1veis do tipo copo.","cls":"PCC","na":false}],"phraseField":"p9_h_desc_i45_u3_frases","unitNcField":"p9_h_desc_i45_u3_nc"},{"answer":"p9_h_desc_i46_u3","serial":46,"classes":["PPR"