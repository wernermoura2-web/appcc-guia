]==null?'':String\(values[n]\);}\n function answer\(n\){var v=raw\(n\).replace\(/^\\//,''\).toUpperCase\(\);return v==='SIM'||v==='S'?'SIM':v==='N\303O'||v==='NAO'||v==='N'?'N\303O':v==='NA'||v==='N\303O APLIC\301VEL'?'NA':'';}\n function number\(v\){var s=String\(v\).trim\(\).replace\(/\\s/g,''\).replace\('%',''\);if\(s.indexOf\(','\)>=0\)s=s.replace\(/\\./g,''\).replace\(',','.'\);var n=Number\(s\);return s!==''&&isFinite\(n\)?n:null;}\n function risk\(code,pc\){return pc===null?'Pendente':config.strict.indexOf\(code\)>=0?\(pc===100?'Baixo':pc>=76?'M\351dio':'Alto'\):\(pc>=76?'Baixo':pc>50?'M\351dio':'Alto'\);}\n function maxRisk\(rs\){if\(rs.indexOf\('Alto'\)>=0\)return 'Alto';if\(rs.indexOf\('Pendente'\)>=0||rs.indexOf\('N\343o avaliado'\)>=0\)return 'Pendente';if\(rs.indexOf\('M\351dio'\)>=0\)return 'M\351dio';if\(rs.indexOf\('Baixo'\)>=0\)return 'Baixo';return 'N\343o aplic\341vel';}\n for\(var mi=0;mi<config.mirrors.length;mi++\){values[config.mirrors[mi].target]=raw\(config.mirrors[mi].source\);mirrored[config.mirrors[mi].target]=true;}\n for\(var gi=0;gi<config.groups.length;gi++\){\n  var g=config.groups[gi],used=false,pending=false,items=[];\n  for\(var mi=0;mi<g.metadata.length;mi++\)if\(!mirrored[g.metadata[mi]]&&raw\(g.metadata[mi]\)&&raw\(g.metadata[mi]\)!=='Off'&&raw\(g.metadata[mi]\)!=='/Off'\)used=true;\n  for\(var ii=0;ii<g.items.length;ii++\){\n   var item=g.items[ii],v=answer\(item.answer\),cl=raw\(item.classField\),classes=cl&&cl!=='Por frase'&&cl.indexOf\('Original:'\)!==0?[cl]:item.classes;\n   var nc=0;for\(var ci=0;ci<classes.length;ci++\)nc=Math.max\(nc,\(config.ncLevels||{PC:1,PPR:2,PPHO:3,PPRO:4,PCC:5}\)[classes[ci]]||0\);\n   var prob=number\(raw\(item.probabilityField\)\),valid=prob!==null&&prob>=1&&prob<=5&&Math.floor\(prob\)===prob;\n   disabled[item.answer]=true;var phraseRows=[];try{phraseRows=JSON.parse\(raw\(item.phraseField\)||'[]'\);}catch\(e\){}\n   var phraseScore=null,hasPhrase=false,phrasePending=false,anyNo=false,allNA=true;\n   hasPhrase=phraseRows.length>0;\n   if\(hasPhrase\){\n    var scored=[];\n    for\(var fj=0;fj<item.phrases.length;fj++\){\n     var def=item.phrases[fj],fr=phraseRows[fj]||{},fv=fr.v||'';\n     if\(fv==='NA'&&def.na\)continue;allNA=false;if\(fv==='N\303O'\)anyNo=true;\n     var fp=fr.p===undefined||fr.p===''?prob:number\(fr.p\),fnc=\(config.ncLevels||{}\)[def.cls]||0;\n     if\(!fv||fp===null||fp<1||fp>5||Math.floor\(fp\)!==fp\)phrasePending=true;\n     scored.push\({v:fv,w:fnc*\(fp||0\),nc:fnc}\);\n    }\n    v=allNA?'NA':anyNo?'N\303O':phrasePending?'':'SIM';\n    phraseScore=0;var phraseNC=nc;for\(var fj=0;fj<scored.length;fj++\)if\(scored[fj].v===\(v==='N\303O'?'N\303O':'SIM'\)&&scored[fj].w>=phraseScore\){phraseScore=scored[fj].w;phraseNC=scored[fj].nc;}\n    values[item.answer]=v;output[item.answer]=v;\n   }\n\n   output[item.ncField]=String\(nc\);if\(item.unitNcField\)output[item.unitNcField]=hasPhrase?String\(phraseNC\):String\(nc\);output[item.weightField]=valid?String\(nc*prob\):'';\n   if\(v\)used=true;if\(v==='NA'\)continue;\n   if\(!v||\(hasPhrase?phrasePending:!valid\)\)pending=true;items.push\({v:v,w:hasPhrase?phraseScore:valid?nc*prob:0}\);\n  }\n  var pc=null,r='N\343o avaliado';\n  if\(used\)for\(var ai=0;ai<g.items.length;ai++\)activeSources[g.items[ai].answer]=true;\n  if\(used\){if\(!items.length\)r='N\343o aplic\341vel';else if\(pending\)r='Pendente';else{var earned=0,total=0;for\(var j=0;j<items.length;j++\){total+=items[j].w;if\(items[j].v==='SIM'\)earned+=items[j].w;}pc=total?Math.round\(1000*earned/total\)/10:null;r=risk\(g.proc,pc\);}}\n  output[g.percent]=pc===null?'':String\(pc\).replace\('.',','\)+'%';output[g.risk]=used?r:'';results.push\({group:g,pc:pc,risk:r,used:used}\);\n }\n\n for\(var i=0;i<config.rows.length;i++\){\n  var row=config.rows[i],v='',has=false,missing=false,active=false;\n  for\(var j=0;j<row.sources.length;j++\){if\(!activeSources[row.sources[j]]\)continue;active=true;var a=answer\(row.sources[j]\);if\(a==='N\303O'\){v='N\303O';break;}if\(!a\)missing=true;else if\(a==='SIM'\)has=true;}\n  if\(!v\)v=!active?'':missing?'Pendente':has?'SIM':'NA';output[row.result]=v;\n }\n for\(var page in config.pages\){\n  var indexes=config.pages[page],rs=[],pcs=[];\n  for\(var j=0;j<indexes.length;j++\){var r=results[indexes[j]];if\(r.used\){rs.push\(r.risk\);if\(r.pc!==null\)pcs.push\(r.pc\);}}\n  output['p'+page+'_risk_result']=rs.length?maxRisk\(rs\):'N\343o avaliado';output['p'+page+'_percent_result']=pcs.length&&rs.indexOf\('Pendente'\)<0?String\(Math.min.apply\(Math,pcs\)\).replace\('.',','\)+'%':'';\n }\n var plantRisks=[];\n for\(var pi=0;pi<config.processes.length;pi++\){\n  var code=config.processes[pi],rs=[],list=[];\n  for\(var j=0;j<results.length;j++\){var result=results[j];if\(result.group.proc===code&&result.used\){rs.push\(result.risk\);list.push\(result\);}}\n  var procRisk=rs.length?maxRisk\(rs\):'N\343o avaliado';plantRisks.push\(procRisk\);output['p18_risco_'+\(pi+1\)]=procRisk;\n  for\(var j=0;j<16;j++\)output['p18_linha_'+\(pi+1\)+'_'+\(j+1\)]=list[j]?\(list[j].group.label+': '+\(list[j].risk==='N\343o aplic\341vel'?'NA':list[j].risk\)\):'';\n }\n var plant=maxRisk\(plantRisks\),n=plant==='Baixo'?1:plant==='M\351dio'?2:plant==='Alto'?3:0;\n output.p18_risco_estabelecimento=plant;output.p19_classificacao=n?'Grupo'+n:'Off';output.p19_classificacao_automatica=n?'Grupo '+n+' - Estabelecimento de '+plant+' Risco':'Classifica\347\343o: '+plant;\n var sum=0,count=0;\n for\(var j=0;j<config.flows.length;j++\){var value=number\(raw\(config.flows[j]\)\);if\(value!==null&&value>=0\){sum+=value;count++;}}\n output.p1_vazao_total=count?String\(Math.round\(sum*1000\)/1000\).replace\('.',','\):'';\n for\(var j=0;j<8;j++\){var field='legal_'+j+'_atende';disabled[field]=raw\('legal_'+j+'_situacao'\)!=='Entregue';if\(disabled[field]\)output[field]='Off';}\n for\(var j=0;j<config.mirrors.length;j++\){var mirror=config.mirrors[j];output[mirror.target]=raw\(mirror.source\);}\n\n for\(var pn in \(config.phraseNotesFields||{}\)\){\n  var noteFields=config.phraseNotesFields[pn],notes=[];\n  for\(var ng=0;ng<config.groups.length;ng++\)if\(config.groups[ng].page===Number\(pn\)\){\n   var group=config.groups[ng];\n   for\(var ni=0;ni<group.items.length;ni++\){\n    var it=group.items[ni],prs=[];try{prs=JSON.parse\(raw\(it.phraseField\)||'[]'\);}catch\(e\){}\n    for\(var nj=0;nj<prs.length;nj++\)if\(prs[nj]&&String\(prs[nj].obs||''\).replace\(/\\s/g,''\)\)notes.push\('Indicador '+it.serial+' / grupo '+group.label+' / frase '+\(nj+1\)+': '+prs[nj].obs\);\n   }\n  }\n  if\(noteFields.length\){var field=noteFields[0],manual=raw\(field\).split\('\\n\\n[OBSERVA\307\325ES POR FRASE]'\)[0];output[field]=manual+\(notes.length?'\\n\\n[OBSERVA\307\325ES POR FRASE]\\n'+notes.join\('\\n\\n'\):''\);}\n }\n return {values:output,disabled:disabled,groups:results,risk:plant};\n}\nif\(typeof module!=='undefined'&&module.exports\)module.exports=AppccCalculate;\n\nvar APPCC_UPDATING=false;\nfunction appccPDFUpdate\(name,value\){\n if\(APPCC_UPDATING\)return;APPCC_UPDATING=true;\n try{\n  var values={},fields=this.numFields;\n  for\(var i=0;i<fields;i++\){var n=this.getNthFieldName\(i\),f=this.getField\(n\);values[n]=f?String\(f.valueAsString||f.value||''\):'';}\n  if\(name&&value!==undefined\)values[name]=String\(value\);\n  for\(var serial in APPCC_CONFIG.classes\){var links=APPCC_CONFIG.classes[serial];for\(var i=0;i<links.length;i++\)for\(var k=0;k<2;k++\)if\(links[i][k]===name\){for\(var j=0;j<links.length;j++\){values[links[j][k]]=String\(value\);var f=this.getField\(links[j][k]\);if\(f&&links[j][k]!==name\)f.value=value;}}}\n  var result=AppccCalculate\(APPCC_CONFIG,values\);\n  for\(var n in result.values\){var f=this.getField\(n\);if\(f\){f.value=f.type==='radiobutton'&&result.values[n]==='N\303O'?'NAO':result.values[n];if\(f.type==='text'\)f.textSize=0;}}\n  for\(var n in result.disabled\){var f=this.getField\(n\);if\(f\){f.readonly=result.disabled[n];f.fillColor=result.disabled[n]?['G',.92]:['G',1];}}\n }finally{APPCC_UPDATING=false;}\n}\nappccPDFUpdate.call\(this\);\n\n\n\n\nvar APPCC_EDITOR=null;\nfunction appccPDFPhrases\(answerName\){\n if\(APPCC_EDITOR\){appccPDFEditorSave.call\(this,true\);}\n var item=null,group=null;for\(var gi=0;gi<APPCC_CONFIG.groups.length;gi++\)for\(var ii=0;ii<APPCC_CONFIG.groups[gi].items.length;ii++\)if\(APPCC_CONFIG.groups[gi].items[ii].answer===answerName\){item=APPCC_CONFIG.groups[gi].items[ii];group=APPCC_CONFIG.groups[gi];}\n if\(!item\)return;var rows=[];try{rows=JSON.parse\(this.getField\(item.phraseField\).valueAsString||'[]'\);}catch\(e\){}\n var source=this.pageNum,start=this.numPages;APPCC_EDITOR={item:item,group:group,source:source,start:start,count:item.editorTemplates.length};\n for\(var t=0;t<item.editorTemplates.length;t++\)this.getTemplate\(item.editorTemplates[t]\).spawn\({nPage:this.numPages,bRename:false,bOverlay:false}\);\n for\(var j=0;j<item.phrases.length;j++\){\n  var prefix='E17_i'+item.serial+'_f'+j+'_',f=item.phrases[j],row=rows[j]||{},p=Number\(row.p\)||Number\(this.getField\(item.probabilityField\).value\)||1;\n  this.getField\(prefix+'cls'\).value=f.cls;this.getField\(prefix+'nc'\).value=APPCC_CONFIG.ncLevels[f.cls];this.getField\(prefix+'p'\).value=p;this.getField\(prefix+'ncp'\).value=APPCC_CONFIG.ncLevels[f.cls]*p;this.getField\(prefix+'obs'\).value=String\(row.obs||''\);\n  for\(var k=0;k<3;k++\){var code=['S','N','A'][k],field=this.getField\(prefix+code\);if\(field\)field.checkThisBox\(0,row.v===['SIM','N\303O','NA'][k]\);}\n }\n this.pageNum=start;\n}\nfunction appccPDFEditorAnswer\(j,code\){\n if\(!APPCC_EDITOR\)return;var prefix='E17_i'+APPCC_EDITOR.item.serial+'_f'+j+'_';for\(var k=0;k<3;k++\){var c=['S','N','A'][k],f=this.getField\(prefix+c\);if\(f\)f.checkThisBox\(0,c===code\);}appccPDFEditorSave.call\(this,false\);\n}\nfunction appccPDFEditorSave\(close,changed,value\){\n if\(!APPCC_EDITOR\)return;var ed=APPCC_EDITOR,item=ed.item,rows=[];\n for\(var j=0;j<item.phrases.length;j++\){\n  var prefix='E17_i'+item.serial+'_f'+j+'_',prob=this.getField\(prefix+'p'\),p=changed===prefix+'p'?Number\(value\):Number\(prob.value\),v='';if\(!isFinite\(p\)||p<1||p>5||Math.floor\(p\)!==p\){app.alert\('Use P de 1 a 5.'\);return;}\n  for\(var k=0;k<3;k++\){var f=this.getField\(prefix+['S','N','A'][k]\);if\(f&&f.isBoxChecked\(0\)\)v=['SIM','N\303O','NA'][k];}\n  rows.push\({v:v,p:p,obs:String\(this.getField\(prefix+'obs'\).valueAsString||''\)}\);this.getField\(prefix+'ncp'\).value=APPCC_CONFIG.ncLevels[item.phrases[j].cls]*p;\n }\n this.getField\(item.phraseField\).value=JSON.stringify\(rows\);appccPDFUpdate.call\(this\);\n var result=String\(this.getField\(item.answer\).valueAsString||''\),text=result==='SIM'?'Resultado do indicador: SIM':result==='NAO'||result==='N\303O'?'Resultado do indicador: N\303O':result==='NA'?'Resultado do indicador: NA':'Item pendente: avalie todas as frases aplic\341veis.';\n for\(var t=0;t<ed.count;t++\){var summary=this.getField\('E17_i'+item.serial+'_summary_'+t\);if\(summary\)summary.value=text;}\n if\(close\){APPCC_EDITOR=null;this.pageNum=ed.source;try{this.deletePages\({nStart:ed.start,nEnd:ed.start+ed.count-1}\);}catch\(e\){}}\n}\n)>>
