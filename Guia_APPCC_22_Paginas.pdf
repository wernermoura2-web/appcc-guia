7_u3_nc"},{"answer":"p8_h_ret_i38_u3","serial":38,"classes":["PPHO"],"classField":"p8_appcc_i38_classe","weightField":"p8_appcc_i38_peso","probability":4,"probabilityField":"p8_appcc_i38_probabilidade","ncField":"p8_appcc_i38_criticidade","phrases":[{"text":"Devem ser implementados Procedimentos Operacionais Padronizados-POP referentes \\u00e0s opera\\u00e7\\u00f5es de higieniza\\u00e7\\u00e3o das embalagens.","cls":"PPHO","na":false},{"text":"Os POP devem conter informa\\u00e7\\u00f5es sobre: natureza da superf\\u00edcie a ser higienizada, m\\u00e9todos de higieniza\\u00e7\\u00e3o, princ\\u00edpios ativos utilizados e sua concentra\\u00e7\\u00e3o, tempo de contato dos agentes qu\\u00edmicos e ou f\\u00edsicos utilizados na opera\\u00e7\\u00e3o de higieniza\\u00e7\\u00e3o, temperatura e outras informa\\u00e7\\u00f5es que se fizerem necess\\u00e1rias.","cls":"PPHO","na":false}],"phraseField":"p8_h_ret_i38_u3_frases","unitNcField":"p8_h_ret_i38_u3_nc"},{"answer":"p8_h_ret_i39_u3","serial":39,"classes":["PC"],"classField":"p8_appcc_i39_classe","weightField":"p8_appcc_i39_peso","probability":4,"probabilityField":"p8_appcc_i39_probabilidade","ncField":"p8_appcc_i39_criticidade","phrases":[{"text":"As condi\\u00e7\\u00f5es de opera\\u00e7\\u00e3o da m\\u00e1quina higienizadora das embalagens retorn\\u00e1veis devem ser aquelas estabelecidas no teste de efici\\u00eancia do processo de higieniza\\u00e7\\u00e3o descrito na norma ABNT 14637 \(Embalagem pl\\u00e1stica para \\u00e1gua mineral e pot\\u00e1vel de mesa - Garraf\\u00e3o retorn\\u00e1vel - requisitos para lavagem, enchimento e fechamento\) ou outra que venha a substitui-la.","cls":"PC","na":false},{"text":"O relat\\u00f3rio da avalia\\u00e7\\u00e3o das condi\\u00e7\\u00f5es de opera\\u00e7\\u00e3o deve ser mantido no empreendimento \\u00e0 disposi\\u00e7\\u00e3o da fiscaliza\\u00e7\\u00e3o.","cls":"PC","na":false}],"phraseField":"p8_h_ret_i39_u3_frases","unitNcField":"p8_h_ret_i39_u3_nc"}],"metadata":["p8_identificacao_0_2"],"percent":"p8_percent_u3","risk":"p8_risk_u3"},{"proc":"4.6","page":8,"column":3,"label":"4","items":[{"answer":"p8_t_ret_i40_u4","serial":40,"classes":["PCC","PC","PPRO","PPHO"],"classField":"p8_appcc_i40_classe","weightField":"p8_appcc_i40_peso","probability":3,"probabilityField":"p8_appcc_i40_probabilidade","ncField":"p8_appcc_i40_criticidade","phrases":[{"text":"As tampas das embalagens n\\u00e3o devem ser ve\\u00edculos de contamina\\u00e7\\u00e3o da \\u00e1gua mineral natural e da \\u00e1gua natural.","cls":"PCC","na":false},{"text":"As tampas das embalagens dever\\u00e3o ser previamente desinfetadas com produto saneante regularizado Anvisa.","cls":"PCC","na":false},{"text":"Caso o fornecedor de tampas garanta, por meio de documenta\\u00e7\\u00e3o comprobat\\u00f3ria, tampas isentas de contamina\\u00e7\\u00e3o, estas n\\u00e3o precisam ser desinfetadas.","cls":"PC","na":true},{"text":"Caso o desinfetante deixe res\\u00edduo, as tampas devem ser enxaguadas com \\u00e1gua para consumo humano.","cls":"PPRO","na":true},{"text":"Devem ser mantidos registros dos testes realizados para comprovar que as tampas n\\u00e3o s\\u00e3o fontes de contamina\\u00e7\\u00e3o.","cls":"PPHO","na":false}],"phraseField":"p8_t_ret_i40_u4_frases","unitNcField":"p8_t_ret_i40_u4_nc"},{"answer":"p8_t_ret_i41_u4","serial":37,"classes":["PPHO"],"classField":"p8_appcc_i37_classe","weightField":"p8_appcc_i37_peso","probability":4,"probabilityField":"p8_appcc_i37_probabilidade","ncField":"p8_appcc_i37_criticidade","phrases":[{"text":"As opera\\u00e7\\u00f5es de limpeza e desinfec\\u00e7\\u00e3o das embalagens devem ser realizadas por funcion\\u00e1rios comprovadamente capacitados, seguindo procedimentos que assegurem condi\\u00e7\\u00f5es higi\\u00eanico- sanit\\u00e1rias satisfat\\u00f3rias.","cls":"PPHO","na":false}],"phraseField":"p8_t_ret_i41_u4_frases","unitNcField":"p8_t_ret_i41_u4_nc"},{"answer":"p8_t_ret_i42_u4","serial":38,"classes":["PPHO"],"classField":"p8_appcc_i38_classe","weightField":"p8_appcc_i38_peso","probability":4,"probabilityField":"p8_appcc_i38_probabilidade","ncField":"p8_appcc_i38_criticidade","phrases":[{"text":"Devem ser implementados Procedimentos Operacionais Padronizados-POP referentes \\u00e0s opera\\u00e7\\u00f5es de higieniza\\u00e7\\u00e3o das embalagens.","cls":"PPHO","na":false},{"text":"Os POP devem conter informa\\u00e7\\u00f5es sobre: natureza da superf\\u00edcie a ser higienizada, m\\u00e9todos de higieniza\\u00e7\\u00e3o, princ\\u00edpios ativos utilizados e sua concentra\\u00e7\\u00e3o, tempo de contato dos agentes qu\\u00edmicos e ou f\\u00edsicos utilizados na opera\\u00e7\\u00e3o de higieniza\\u00e7\\u00e3o, temperatura e outras informa\\u00e7\\u00f5es que se fizerem necess\\u00e1rias.","cls":"PPHO","na":false}],"phraseField":"p8_t_ret_i42_u4_frases","unitNcField":"p8_t_ret_i42_u4_nc"}],"metadata":["p8_identificacao_0_3"],"percent":"p8_percent_u4","risk":"p8_risk_u4"},{"proc":"4.6","page":9,"column":0,"label":"1","items":[{"answer":"p9_h_desc_i43_u1","serial":43,"classes":["PCC"],"classField":"p9_appcc_i43_classe","weightField":"p9_appcc_i43_peso","probability":3,"probabilityField":"p9_appcc_i43_probabilidade","ncField":"p9_appcc_i43_criticidade","phrases":[{"text":"As embalagens de primeiro uso, quando n\\u00e3o fabricadas no pr\\u00f3prio estabelecimento industrial, devem ser submetidas ao enx\\u00e1gue em equipamento autom\\u00e1tico, utilizando- se solu\\u00e7\\u00e3o desinfetante.","cls":"PCC","na":true}],"phraseField":"p9_h_desc_i43_u1_frases","unitNcField":"p9_h_desc_i43_u1_nc"},{"answer":"p9_h_desc_i44_u1","serial":44,"classes":["PC"],"classField":"p9_appcc_i44_classe","weightField":"p9_appcc_i44_peso","probability":4,"probabilityField":"p9_appcc_i44_probabilidade","ncField":"p9_appcc_i44_criticidade","phrases":[{"text":"As embalagens retornadas para um novo ciclo de uso, antes da etapa de higieniza\\u00e7\\u00e3o autom\\u00e1tica, devem ser submetidas \\u00e0 pr\\u00e9-lavagem para a remo\\u