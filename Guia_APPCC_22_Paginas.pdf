<</Type/Action/S/JavaScript/JS(var APPCC_CONFIG={"groups":[{"proc":"4.1","page":1,"column":0,"label":"1","items":[{"answer":"p1_cap_i1_u1","serial":1,"classes":["PPR"],"classField":"p1_appcc_i1_classe","weightField":"p1_appcc_i1_peso","probability":2,"probabilityField":"p1_appcc_i1_probabilidade","ncField":"p1_appcc_i1_criticidade","phrases":[{"text":"A \\u00e1rea circundante \\u00e0 casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser pavimentada, mantida limpa e livre de focos de contamina\\u00e7\\u00e3o.","cls":"PPR","na":false},{"text":"Deve dispor de um sistema de drenagem de \\u00e1guas pluviais, de modo a impedir a infiltra\\u00e7\\u00e3o de contaminantes, n\\u00e3o comprometendo a qualidade sanit\\u00e1ria da \\u00e1gua.","cls":"PPR","na":false}],"phraseField":"p1_cap_i1_u1_frases","unitNcField":"p1_cap_i1_u1_nc"},{"answer":"p1_cap_i2_u1","serial":2,"classes":["PPHO","PPR"],"classField":"p1_appcc_i2_classe","weightField":"p1_appcc_i2_peso","probability":3,"probabilityField":"p1_appcc_i2_probabilidade","ncField":"p1_appcc_i2_criticidade","phrases":[{"text":"A casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser mantida em condi\\u00e7\\u00e3o higi\\u00eanico- sanit\\u00e1ria satisfat\\u00f3ria, livre de infiltra\\u00e7\\u00f5es, rachaduras, fendas e outras altera\\u00e7\\u00f5es que possam comprometer a qualidade da \\u00e1gua captada.","cls":"PPHO","na":false},{"text":"No in\\u00edcio da canaliza\\u00e7\\u00e3o de capta\\u00e7\\u00e3o da \\u00e1gua, devem ser instaladas tubula\\u00e7\\u00e3o e v\\u00e1lvula espec\\u00edficas para a coleta de amostras.","cls":"PPR","na":false},{"text":"Capta\\u00e7\\u00f5es, tubula\\u00e7\\u00f5es e equipamentos em contato com a \\u00e1gua de envase devem ser mantidos sem vazamentos.","cls":"PPHO","na":false}],"phraseField":"p1_cap_i2_u1_frases","unitNcField":"p1_cap_i2_u1_nc"},{"answer":"p1_cap_i3_u1","serial":3,"classes":["PPHO"],"classField":"p1_appcc_i3_classe","weightField":"p1_appcc_i3_peso","probabili